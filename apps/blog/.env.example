# Copy to .env for local development. Never commit real values.
# On Vercel, set these in Project → Settings → Environment Variables.

# PostgreSQL connection string. In production use your provider's POOLED
# connection string (e.g. Neon/Supabase pooler) because every serverless
# function opens its own connections.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/blog_dev

# Signs sessions and encrypts Payload internals. >= 32 random characters.
#   openssl rand -hex 32
PAYLOAD_SECRET=

# Shared secret embedded in admin preview links. >= 32 random characters and
# different from PAYLOAD_SECRET. Draft preview ALSO requires an admin session.
#   openssl rand -hex 32
PREVIEW_SECRET=

# Canonical public origin. Required for the Production environment on Vercel.
# Used for canonical URLs, sitemap, RSS, Open Graph, CORS/CSRF and preview links.
# Leave unset for local dev (defaults to http://localhost:3000) and for Vercel
# preview deployments (falls back to the deployment's own VERCEL_URL).
SITE_URL=http://localhost:3000

# Vercel Blob read/write token for media uploads. Leave empty locally to store
# uploads in ./media on disk. REQUIRED in production: serverless file systems
# are ephemeral. Created automatically when you attach a Blob store to the project.
BLOB_READ_WRITE_TOKEN=
